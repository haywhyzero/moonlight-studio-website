# Moonlight Studio Website & License Service Configuration
# Copy this file to .env and adjust values for local development.

# Public origin. Must be HTTPS in production; used for payment callbacks.
PUBLIC_BASE_URL=http://127.0.0.1:8787
WEBSITE_URL=http://127.0.0.1:8787

# Where the Windows setup.exe lives. Leave empty to hide download buttons.
DOWNLOAD_URL=

# Payment Provider: mock | paystack | flutterwave
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_CURRENCY=NGN

# Resend Email Receipts (production only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Moonlight Studio <billing@moonlight.studio>

# Secret token for the private /buds pricing page.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Access: https://your-domain.com/buds?token=<this-value>
BUDS_ACCESS_TOKEN=

# Generate once with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every issued entitlement token and redemption code.
LICENSE_SECRET=dev-only-change-this-license-secret
# Optional separate pepper; defaults to LICENSE_SECRET + ':code'.
CODE_PEPPER=

# SQLite path. Use a persistent volume in production (e.g. /var/data/moonlight.sqlite3).
MOONLIGHT_DB_PATH=data/moonlight.sqlite3

# Abuse controls.
ACTIVATION_ATTEMPTS_PER_HOUR=20
CHECKOUT_ATTEMPTS_PER_HOUR=30
MAX_USAGE_DELTA_SECONDS=300

# Enable (1) behind Cloudflare or trusted reverse proxies.
TRUST_PROXY_HEADERS=0

# Allow mock payments on HTTPS (staging only).
ALLOW_MOCK_PAYMENTS=0
